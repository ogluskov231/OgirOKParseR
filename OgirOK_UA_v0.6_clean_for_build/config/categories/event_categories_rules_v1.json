{
  "schema": "cucumberdoc.category_rules",
  "version": "1.0.0",
  "description": "Правила присвоення категорій 'Надійшло/Вибуло' для наказів. Порядок правил = пріоритет (зверху вниз).",
  "normalization": {
    "lowercase": true,
    "strip": true,
    "collapse_whitespace": true,
    "apostrophes_to_ascii": true,
    "normalize_vch": true,
    "notes": [
      "normalize_vch: зводить 'вч', 'в\\ч', 'в/ч' до 'в/ч' перед матчингом"
    ]
  },
  "event_type_detection": {
    "policy": "departure_wins_if_both",
    "departure_triggers": [
      "звільн",
      "виключ",
      "загиб",
      "помер",
      "переведен",
      "виведен.*розпорядженн",
      "призупинен.*служб",
      "\\bу\\s+запасн(у|а)\\s+рот",
      "\\bу\\s+окрем(і|и)\\s+батальйон"
    ],
    "arrival_triggers": [
      "прибув",
      "прибутт",
      "зарахув",
      "призван",
      "направлен",
      "\\bз\\s+розпорядженн",
      "\\bз\\s+в/ч\\b"
    ],
    "notes": [
      "Якщо в одному блоці для одного ПІБ є ознаки і прибуття, і вибуття — event_type=departure.",
      "Якщо в документі різні речення/пункти — можна створити 2 записи (arrival і departure) для одного ПІБ з різними фрагментами."
    ]
  },
  "arrival_rules": [
    {
      "id": "arr_reserve_battalion",
      "label": "з батальйонів резерву",
      "match": {
        "any": [
          "батальйон(ів)?\\s+резерв"
        ]
      }
    },
    {
      "id": "arr_spare_companies",
      "label": "з запасних рот",
      "match": {
        "any": [
          "запасн(а|і)\\s+рот"
        ]
      }
    },
    {
      "id": "arr_nc",
      "label": "з НЦ",
      "match": {
        "any": [
          "\\bнц\\b"
        ]
      }
    },
    {
      "id": "arr_cpp",
      "label": "з ЦПП",
      "match": {
        "any": [
          "\\bцпп\\b"
        ]
      }
    },
    {
      "id": "arr_nbrss",
      "label": "з НБРСС",
      "match": {
        "any": [
          "\\bнбрсс\\b"
        ]
      }
    },
    {
      "id": "arr_nbros",
      "label": "з НБРОС",
      "match": {
        "any": [
          "\\bнброс\\b"
        ]
      }
    },
    {
      "id": "arr_zvp",
      "label": "з ЗВП",
      "match": {
        "any": [
          "\\bзвп\\b"
        ]
      }
    },
    {
      "id": "arr_vvnz",
      "label": "з ВВНЗ",
      "match": {
        "any": [
          "\\bввнз\\b"
        ]
      }
    },
    {
      "id": "arr_vkss",
      "label": "з ВКСС",
      "match": {
        "any": [
          "\\bвк(сс|cc)\\b"
        ]
      }
    },
    {
      "id": "arr_kkpk",
      "label": "з ККПК",
      "match": {
        "any": [
          "\\bккпк\\b"
        ]
      }
    },
    {
      "id": "arr_from_other_units",
      "label": "з інших військових частин",
      "match": {
        "any": [
          "інш(их|і)\\s+військов(их|і)\\s+частин",
          "\\bз\\s+в/ч\\b",
          "з\\s+військов(ої|ої)\\s+частин"
        ]
      }
    },
    {
      "id": "arr_disp_after_treatment",
      "label": "з розпорядження після лікування",
      "match": {
        "any": [
          "з\\s+розпорядженн(я|я)\\s+після\\s+лікуван"
        ]
      }
    },
    {
      "id": "arr_disp_return_szch",
      "label": "з розпорядження повернення з СЗЧ",
      "match": {
        "any": [
          "з\\s+розпорядженн(я|я).*(сзч|самовільн)"
        ]
      }
    },
    {
      "id": "arr_disp_return_missing",
      "label": "з розпорядження повернення після зниклих безвісти",
      "match": {
        "any": [
          "з\\s+розпорядженн(я|я).*(зникл|безвіст)"
        ]
      }
    },
    {
      "id": "arr_disp_return_pow",
      "label": "з розпорядження повернення з полону",
      "match": {
        "any": [
          "з\\s+розпорядженн(я|я).*(полон)"
        ]
      }
    },
    {
      "id": "arr_disp_after_org",
      "label": "з розпорядження після проведення організаційних заходів",
      "match": {
        "any": [
          "з\\s+розпорядженн(я|я).*(організаційн)"
        ]
      }
    },
    {
      "id": "arr_disp_other",
      "label": "з розпорядження інше",
      "match": {
        "any": [
          "з\\s+розпорядженн(я|я)"
        ]
      }
    },
    {
      "id": "arr_called_by_cmd",
      "label": "призвано командирами частин безпосередньо до військової частини",
      "match": {
        "any": [
          "призван(о|і).*(командир)"
        ]
      }
    },
    {
      "id": "arr_called_tck_sp",
      "label": "призвано з ТЦК та СП (по мобілізації, на контракт)",
      "match": {
        "any": [
          "\\bтцк\\b",
          "\\bсп\\b",
          "територіальн(ий|ого)\\s+центр"
        ]
      }
    },
    {
      "id": "arr_contract_18_24",
      "label": "контракт 18-24",
      "match": {
        "any": [
          "контракт\\s*18\\s*[-–]\\s*24",
          "\\b18\\s*[-–]\\s*24\\b"
        ]
      }
    },
    {
      "id": "arr_from_separate_battalions",
      "label": "з окремих батальйонів (штатні бригади)",
      "match": {
        "any": [
          "окрем(их|і)\\s+батальйон(ів|и).*(штатн)"
        ]
      }
    },
    {
      "id": "arr_other_sources",
      "label": "інші джерела надходження",
      "match": {
        "any": [
          ".*"
        ]
      },
      "fallback": true
    }
  ],
  "departure_rules": [
    {
      "id": "dep_kia_combat",
      "label": "загибеллю (бойові)",
      "match": {
        "any": [
          "загиб(ел|ли).*(бойов)"
        ]
      }
    },
    {
      "id": "dep_kia_noncombat",
      "label": "загиблі інші, померлі (не бойові)",
      "match": {
        "any": [
          "(загиб(ел|ли)|помер(л|ли))"
        ],
        "none": [
          "бойов"
        ]
      }
    },
    {
      "id": "dep_discharge_health",
      "label": "звільнення з військової служби за станом здоров'я",
      "match": {
        "any": [
          "звільн(ен|енн|ити).*(здоров)"
        ]
      }
    },
    {
      "id": "dep_discharge_age",
      "label": "звільнення з військової служби за віком",
      "match": {
        "any": [
          "звільн.*(вік|за\\s+віком)"
        ]
      }
    },
    {
      "id": "dep_discharge_family",
      "label": "звільнення з військової служби за сімейними обставинами",
      "match": {
        "any": [
          "звільн.*сімейн"
        ]
      }
    },
    {
      "id": "dep_discharge_term_end",
      "label": "звільнення з військової служби закінчення строку служби",
      "match": {
        "any": [
          "звільн.*(закінчен|строк).*служб"
        ]
      }
    },
    {
      "id": "dep_discharge_after_pow",
      "label": "звільнення з військової служби після повернення з полону",
      "match": {
        "any": [
          "звільн.*після.*полон"
        ]
      }
    },
    {
      "id": "dep_discharge_other",
      "label": "звільнення з військової служби інші причини",
      "match": {
        "any": [
          "звільн"
        ]
      }
    },
    {
      "id": "dep_transferred_other_unit",
      "label": "переведено до інших в/ч",
      "match": {
        "any": [
          "переведен(о|і).*інш(их|і).*(в/ч|частин)",
          "до\\s+інш(ої|их).*частин"
        ]
      }
    },
    {
      "id": "dep_disp_long_treatment",
      "label": "виведення в розпорядження довгострокове лікування",
      "match": {
        "any": [
          "виведен.*розпорядженн.*(довгострок|лікуван)"
        ]
      }
    },
    {
      "id": "dep_disp_szch",
      "label": "виведення в розпорядження СЗЧ",
      "match": {
        "any": [
          "виведен.*розпорядженн.*(сзч|самовільн)"
        ]
      }
    },
    {
      "id": "dep_disp_missing",
      "label": "виведення в розпорядження зниклі безвісти",
      "match": {
        "any": [
          "виведен.*розпорядженн.*(зникл|безвіст)"
        ]
      }
    },
    {
      "id": "dep_disp_pow",
      "label": "виведення в розпорядження полон",
      "match": {
        "any": [
          "виведен.*розпорядженн.*полон"
        ]
      }
    },
    {
      "id": "dep_disp_org",
      "label": "виведення в розпорядження у зв'язку з проведенням організаційних заходів",
      "match": {
        "any": [
          "виведен.*розпорядженн.*організаційн"
        ]
      }
    },
    {
      "id": "dep_disp_other",
      "label": "виведення в розпорядження інші",
      "match": {
        "any": [
          "виведен.*розпорядженн"
        ]
      }
    },
    {
      "id": "dep_suspend_service",
      "label": "призупинення військової служби",
      "match": {
        "any": [
          "призупинен.*служб"
        ]
      }
    },
    {
      "id": "dep_to_spare_company",
      "label": "у запасну роту",
      "match": {
        "any": [
          "\\bу\\s+запасн(у|а)\\s+рот"
        ]
      }
    },
    {
      "id": "dep_to_separate_battalion",
      "label": "у окремі батальйони (штатні бригади)",
      "match": {
        "any": [
          "\\bу\\s+окрем(і|и)\\s+батальйон(и|и).*(штатн)"
        ]
      }
    },
    {
      "id": "dep_other_reasons",
      "label": "інші причини",
      "match": {
        "any": [
          ".*"
        ]
      },
      "fallback": true
    }
  ],
  "matching": {
    "regex_flags": [
      "IGNORECASE",
      "UNICODE",
      "DOTALL"
    ],
    "first_match_wins": true,
    "allow_multiple_rules": false,
    "notes": [
      "Обробка: для події (arrival/departure) іде послідовна перевірка правил; перше правило що спрацювало — категорія.",
      "fallback=True правило має стояти останнім."
    ]
  },
  "output_fields": {
    "event_type": [
      "arrival",
      "departure"
    ],
    "category_field_by_event_type": {
      "arrival": "arrival_category",
      "departure": "departure_category"
    },
    "audit_fields": [
      "matched_rule_id",
      "matched_rule_label",
      "match_span_start",
      "match_span_end",
      "match_snippet"
    ]
  }
}